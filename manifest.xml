<manifest version="1.0" type="device">
    <!-- Boot Control HAL -->
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Health HAL -->
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Fastboot HAL -->
    <hal format="hidl">
        <name>android.hardware.fastboot</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>IFastboot</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>

