on early-init
    # Load kernel modules for recovery
    insmod /vendor/lib/modules/q6_pdr_dlkm.ko
    insmod /vendor/lib/modules/q6_notifier_dlkm.ko
    insmod /vendor/lib/modules/snd_event_dlkm.ko
    insmod /vendor/lib/modules/gpr_dlkm.ko
    insmod /vendor/lib/modules/spf_core_dlkm.ko
    insmod /vendor/lib/modules/adsp_loader_dlkm.ko

on init
    # Set display brightness
    write /sys/class/backlight/panel0-backlight/brightness 1200
    
    # USB configuration
    setprop sys.usb.configfs 1
    setprop sys.usb.controller a600000.dwc3

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    
    # Force firmware loading through sysfs
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    
    # Create firmware directories
    mkdir /vendor/firmware_mnt 0771 system system
    mkdir /vendor/firmware 0771 system system
    
    # Mount firmware partition
    mount vfat /dev/block/bootdevice/by-name/modem /vendor/firmware_mnt ro shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0
    
    # Wait for ADSP
    wait /sys/kernel/boot_adsp/boot 1
    write /sys/kernel/boot_adsp/boot 1
    
    # Wait for battery device
    wait /sys/class/power_supply/battery

on post-fs
    start boot-hal-1-2

service boot-hal-1-2 /system/bin/android.hardware.boot@1.2-service
    interface android.hardware.boot@1.0::IBootControl default
    interface android.hardware.boot@1.1::IBootControl default
    interface android.hardware.boot@1.2::IBootControl default
    user root
    group root
    disabled
    seclabel u:recovery:s0

service hwservicemanager /system/bin/hwservicemanager
    user root
    group root readproc
    disabled
    onrestart setprop hwservicemanager.ready false
    seclabel u:recovery:s0

service servicemanager /system/bin/servicemanager
    user root
    group root readproc
    disabled
    seclabel u:recovery:s0

service health-hal-2-1 /system/bin/android.hardware.health@2.1-service
    interface android.hardware.health@2.0::IHealth default
    interface android.hardware.health@2.1::IHealth default
    user root
    group root
    disabled
    seclabel u:recovery:s0

