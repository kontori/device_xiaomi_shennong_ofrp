# System Properties for Xiaomi 14 Pro (shennong)

# Device
ro.product.device=shennong
ro.product.model=23116PN5BC
ro.product.brand=Xiaomi
ro.product.name=shennong
ro.product.manufacturer=Xiaomi
ro.product.board=pineapple
ro.board.platform=pineapple

# Build
ro.build.product=shennong
ro.build.fingerprint=Xiaomi/shennong/shennong:14/UKQ1.240624.001/OS3.0.4.0.WNBCNXM:user/release-keys
ro.system.build.fingerprint=Xiaomi/shennong/shennong:14/UKQ1.240624.001/OS3.0.4.0.WNBCNXM:user/release-keys
ro.vendor.build.fingerprint=Xiaomi/shennong/shennong:14/UKQ1.240624.001/OS3.0.4.0.WNBCNXM:user/release-keys

# Security
ro.build.version.security_patch=2025-10-01
ro.vendor.build.security_patch=2025-10-01

# Crypto
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.volume.metadata.method=dm-default-key
ro.crypto.volume.options=::v2

# Virtual A/B
ro.virtual_ab.enabled=true
ro.virtual_ab.compression.enabled=true
ro.virtual_ab.userspace.snapshots.enabled=true

# USB
vendor.usb.controller=a600000.dwc3
sys.usb.controller=a600000.dwc3

# Display
ro.sf.lcd_density=560

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Disable APEX
ro.apex.updatable=false

